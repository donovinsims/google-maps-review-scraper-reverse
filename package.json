{
  "name": "gmaps-reviews",
  "version": "0.1.0",
  "type": "module",
  "main": "src/cli/index.js",
  "bin": {
    "gmr": "src/cli/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "postinstall": "npx playwright install chromium 2>/dev/null || true",
    "cli": "node src/cli/index.js",
    "run:all": "node src/cli/index.js run urls.txt",
    "export:csv": "node src/cli/index.js export --format csv --out data/export/reviews.csv",
    "export:json": "node src/cli/index.js export --format json --out data/export/reviews.json",
    "serve": "node src/cli/index.js serve",
    "poc": "node scripts/poc.mjs"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "express": "^4.21.0",
    "playwright": "^1.50.0",
    "rebrowser-playwright": "^1.64.101"
  },
  "keywords": [
    "google-maps",
    "reviews",
    "scraper",
    "local"
  ],
  "license": "MIT"
}
